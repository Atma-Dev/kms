GARTISAN_DATABASE_URL=postgres://postgres:lnfavjem@localhost:5432/kms?sslmode=disable
APP_ENV=local
APP_DEBUG=false
APP_PORT=8019
DB_USER=postgres
DB_PASSWORD=lnfavjem
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kms


OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=http://localhost:8019/api/auth/google/callback

FRONTEND_URL=http://localhost:3019

JWT_SIGNING_METHOD=HS256
JWT_SECRET_KEY=your-secret-key
JWT_ACCESS_TOKEN_TTL=30
JWT_REFRESH_TOKEN_TTL=10080
JWT_BLACKLIST_DRIVER=redis
JWT_REDIS_HOST=localhost
JWT_REDIS_PORT=6379
JWT_REDIS_PASSWORD=
JWT_REDIS_DB=0
JWT_BLACKLIST_INCIDENT_TIME_KEY=jwt_incident_time


SENTRY_DSN=

SCHEDULE_LEASE_TTL_MINUTES=5

QUEUE_WORKERS=5
QUEUE_NAMES=default
QUEUE_POLL_INTERVAL_SECONDS=3
QUEUE_MAX_RUN_TIME_SECONDS=300
QUEUE_BACKOFF_BASE_SECONDS=10
QUEUE_BACKOFF_MAX_SECONDS=600
QUEUE_RETENTION_DAYS=7
# Attachments and inline images (app/attachment). STORAGE_PATH is the root
# every file_path is relative to; mount it as a volume in production.
STORAGE_PATH=storage
UPLOAD_MAX_SIZE_MB=10
UPLOAD_IMAGE_MAX_SIZE_MB=5

# Inline images are uploaded before the document exists (FR-8), so ones whose
# draft was abandoned belong to nothing. prune-orphan-uploads reclaims them.
UPLOAD_ORPHAN_RETENTION_HOURS=24

# Modul 4 FR-5: ceiling on how long a share link may be set to last. 720h = 30 days.
VIEW_SESSION_MAX_TTL_HOURS=720

# How many past queries per user survive the nightly search-history prune.
SEARCH_HISTORY_KEEP_PER_USER=50

# prune-search-histories keeps the newest N per user; the box only shows 10.
SEARCH_HISTORY_KEEP_PER_USER=50
